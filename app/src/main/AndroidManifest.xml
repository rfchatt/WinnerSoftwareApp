<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_appicon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_appicon"
        android:supportsRtl="true"
        android:theme="@style/Theme.WinnerSoftwareApp">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".Client.clientLogin" android:exported="false"/>

        <activity android:name=".Client.clientRegister" android:exported="false"/>

        <activity android:name=".Client.clientHome" android:exported="false"/>

        <activity android:name=".Client.clientTicket" android:exported="false"/>

        <activity android:name=".Client.clientDemande" android:exported="false"/>

        <activity android:name=".Client.clientProfil" android:exported="false"/>

        <activity android:name=".Admin.adminLogin" android:exported="false"/>

        <activity android:name=".Admin.adminHome" android:exported="false"/>

        <activity android:name=".Admin.adminClientDetails" android:exported="false"/>

    </application>

</manifest>