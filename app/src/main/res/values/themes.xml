<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WinnerSoftwareApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Define your brand colors here -->
        <item name="colorPrimary">@color/blue</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- This makes the status bar icons dark (for white backgrounds) -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.WinnerSoftwareApp" parent="Base.Theme.WinnerSoftwareApp" />

    <!-- Style for Circular Avatar -->
    <style name="CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>