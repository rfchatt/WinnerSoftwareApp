<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <selector>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="@color/white"
                        android:endColor="@color/softGray"
                        android:angle="270"
                        android:type="linear"
                        />
                    <corners
                        android:topRightRadius="@dimen/margin_large"
                        android:bottomLeftRadius="@dimen/margin_small"
                        android:bottomRightRadius="@dimen/margin_small"
                        />
                </shape>
            </item>
        </selector>
    </item>

</layer-list>