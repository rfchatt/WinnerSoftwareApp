<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/pure_black"
    tools:context=".views.client.clientRegister">

    <FrameLayout
        android:id="@+id/header_frame"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_services"
            android:scaleType="centerCrop"
            android:contentDescription="Header Background"
            />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_fade_gradient"
            />

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:background="@color/background_main"
        app:layout_constraintTop_toBottomOf="@+id/header_frame"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/margin_large">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/creer_compte"
                android:gravity="center"
                android:textColor="@color/blue"
                android:fontFamily="@font/playfair"
                android:textStyle="bold"
                android:textSize="@dimen/txt_large"
                android:layout_marginBottom="@dimen/margin_small"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/creer_compte_description"
                android:gravity="center"
                android:textColor="@color/text_main"
                android:fontFamily="@font/cairo"
                android:textSize="@dimen/txt_small"
                android:layout_marginBottom="@dimen/margin_large"
                />

            <!-- Client Name Field -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nom de Client"
                app:startIconDrawable="@drawable/ic_user"
                app:startIconTint="@color/blue"
                android:layout_marginTop="@dimen/margin_small"
                app:boxStrokeColor="@color/blue"
                app:hintTextColor="@color/blue"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_client_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:maxLength="50"
                    android:textColor="@color/text_main"
                    android:fontFamily="@font/cairo"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ICE Number Field -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/numero_ice"
                app:startIconDrawable="@drawable/ic_card"
                app:startIconTint="@color/blue"
                android:layout_marginTop="@dimen/margin_medium"
                app:boxStrokeColor="@color/blue"
                app:hintTextColor="@color/blue"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_client_ce_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/text_main"
                    android:fontFamily="@font/cairo"
                    android:maxLength="20"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone Field -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Numero de téléphone"
                app:startIconDrawable="@drawable/ic_phone"
                app:startIconTint="@color/blue"
                android:layout_marginTop="@dimen/margin_medium"
                app:boxStrokeColor="@color/blue"
                app:hintTextColor="@color/blue"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_client_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textColor="@color/text_main"
                    android:fontFamily="@font/cairo"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email Field -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Adresse e-mail"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="@color/blue"
                android:layout_marginTop="@dimen/margin_medium"
                app:boxStrokeColor="@color/blue"
                app:hintTextColor="@color/blue"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_client_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_main"
                    android:fontFamily="@font/cairo"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Field -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/mot_de_passe"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/blue"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/blue"
                android:layout_marginTop="@dimen/margin_medium"
                app:boxStrokeColor="@color/blue"
                app:hintTextColor="@color/blue"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tiet_client_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/text_main"
                    android:fontFamily="@font/cairo"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirm Password Field -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/confirmation_mot_passe"
                app:startIconDrawable="@drawable/ic_lock_check"
                app:startIconTint="@color/blue"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/blue"
                android:layout_marginTop="@dimen/margin_medium"
                app:boxStrokeColor="@color/blue"
                app:hintTextColor="@color/blue"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tiet_client_password_confirmation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/text_main"
                    android:fontFamily="@font/cairo"
                    android:maxLines="1"
                    android:imeOptions="actionDone"
                    />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mb_register"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                app:cornerRadius="@dimen/corner1"
                android:backgroundTint="@color/blue"
                android:text="@string/registre"
                android:textStyle="bold"
                android:textColor="@color/pure_white"
                android:textSize="@dimen/txt_medium"
                android:fontFamily="@font/cairo"
                android:layout_marginTop="@dimen/margin_large"
                android:elevation="4dp"
                />

            <TextView
                android:id="@+id/tv_already_have_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/jai_deja_compte"
                android:gravity="center"
                android:textColor="@color/text_main"
                android:textSize="@dimen/txt_small"
                android:fontFamily="@font/cairo"
                android:layout_marginTop="@dimen/margin_large"
                android:padding="@dimen/margin_small"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
