<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="@dimen/margin_small"
    android:layout_marginHorizontal="5dp"
    app:cardCornerRadius="@dimen/corner1"
    app:strokeWidth="0dp"
    app:cardElevation="0dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="200dp"
        android:orientation="vertical"
        android:background="@color/surface_card"
        android:padding="@dimen/margin_medium">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:backgroundTint="@color/navy_blue"
                app:cardCornerRadius="@dimen/corner2">

                <TextView
                    android:id="@+id/ivClientN"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/white"
                    android:fontFamily="@font/playfair"
                    android:textStyle="bold"
                    android:textSize="@dimen/txt_medium"
                    />

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvClientName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Client name"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="@dimen/margin_medium"
                    android:textStyle="bold"
                    android:textSize="@dimen/txt_small"
                    android:fontFamily="@font/cairo"
                    />

                <TextView
                    android:id="@+id/tvClientICE"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ICE: ..."
                    android:textColor="@color/blue"
                    android:paddingHorizontal="@dimen/margin_medium"
                    android:textSize="@dimen/txt_small"
                    android:fontFamily="@font/cairo"
                    />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/surface_card"
                app:strokeWidth="1dp"
                app:strokeColor="@color/navy_blue"
                app:cardCornerRadius="@dimen/corner1">

                <TextView
                    android:id="@+id/tvProductType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="80dp"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="Type"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/txt_smallest"
                    android:textStyle="bold"
                    android:fontFamily="@font/cairo"
                    />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/navy_blue"
            android:layout_marginVertical="@dimen/corner_small"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:weightSum="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Product name"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="@dimen/txt_small"
                    android:fontFamily="@font/cairo"
                    />

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Issue description..."
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/txt_small"
                    android:fontFamily="@font/cairo"
                    />

            </LinearLayout>

            <View
                android:layout_width="0.5dp"
                android:layout_height="match_parent"
                android:background="@color/navy_blue"
                />

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivCall"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:padding="0dp"
                    android:src="@drawable/img_call"
                    app:iconGravity="textStart"
                    android:layout_marginBottom="3dp"
                    />

                <ImageView
                    android:id="@+id/imEmail"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:padding="0dp"
                    android:src="@drawable/ic_email"
                    app:iconGravity="textStart"
                    android:layout_marginBottom="3dp"
                    />

                <ImageView
                    android:id="@+id/ivDelete"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:padding="0dp"
                    android:src="@drawable/img_trash"
                    app:iconGravity="textStart"
                    />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>