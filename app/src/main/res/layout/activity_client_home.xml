<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".views.client.clientHome">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_background">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center_vertical"
            android:background="@color/surface_card"
            android:paddingHorizontal="@dimen/margin_small"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/img_logo"
                android:scaleType="fitStart"
                />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/margin_medium"
                android:text="@string/app_name"
                android:textColor="@color/navy_blue"
                android:textSize="@dimen/txt_medium"
                android:textStyle="bold"
                android:fontFamily="@font/playfair"
                />

            <ImageView
                android:id="@+id/iv_hamburger"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:src="@drawable/img_hamburger"
                android:padding="@dimen/margin_small"
                android:contentDescription="Menu"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/navy_blue"
                />

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
            app:layout_constraintTop_toBottomOf="@id/header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bienvenue,"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/txt_medium"
                    android:fontFamily="@font/cairo"
                    />

                <TextView
                    android:id="@+id/tv_user_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/navy_blue"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/cairo"
                    />

                <View
                    android:layout_width="75dp"
                    android:layout_height="3dp"
                    android:background="@color/navy_blue"
                    />

                <!-- Action Card 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="@dimen/corner1"
                    app:strokeColor="@color/navy_blue"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/margin_medium">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tableau de Bord"
                            android:textColor="@color/navy_blue"
                            android:fontFamily="@font/cairo"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Gérez vos équipements et demandes d'assistance."
                            android:textColor="@color/navy_blue"
                            android:alpha="0.85"
                            android:fontFamily="@font/cairo"
                            android:textSize="@dimen/txt_small"
                            />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mb_addTicket"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="@dimen/margin_medium"
                            android:text="Nouveau Ticket"
                            android:textAllCaps="false"
                            android:textColor="@color/surface_card"
                            app:backgroundTint="@color/navy_blue"
                            app:strokeColor="@color/navy_blue"
                            app:strokeWidth="1dp"
                            android:textSize="@dimen/txt_small"
                            android:textStyle="bold"
                            android:fontFamily="@font/cairo"
                            app:cornerRadius="@dimen/corner1"
                            app:icon="@android:drawable/ic_input_add"
                            app:iconTint="@color/surface_card"
                            />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/navy_blue"
                    android:layout_marginTop="@dimen/margin_medium"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_marginBottom="12dp"
                    android:text="DEMANDES DES SERVICES"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/cairo"
                    android:textStyle="bold"
                    android:alpha="0.8"
                    />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="150dp"
                    android:background="@drawable/bg_border_radius_blue"
                    android:backgroundTint="@color/softGray">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewDemandes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:listitem="@layout/item_client_demande"
                        />

                    <ProgressBar
                        android:id="@+id/pb_home_demandes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/navy_blue"
                        android:visibility="visible"
                        />

                    <TextView
                        android:id="@+id/tvEmptyDemandes"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Aucune Demande !"
                        android:textColor="@color/hintGray"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:visibility="gone"
                        android:fontFamily="@font/cairo"
                        />

                </FrameLayout>

                <!-- Urgent Support Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/softGray"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Support Urgent 24/7"
                            android:textColor="@color/red"
                            android:textSize="@dimen/txt_medium"
                            android:fontFamily="@font/cairo"
                            android:textStyle="bold"
                            />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Assistance immédiate pour les pannes critiques."
                            android:textColor="@color/text_secondary"
                            android:fontFamily="@font/cairo"
                            android:textSize="@dimen/txt_small"
                            />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mb_callTechnician"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="16dp"
                            android:text="Appeler un technicien"
                            android:textAllCaps="false"
                            android:fontFamily="@font/cairo"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/surface_background"
                            app:strokeColor="@color/softGray"
                            app:strokeWidth="1dp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_phone"
                            app:iconTint="@color/red"
                            />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_card"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/navy_blue"
            app:itemTextColor="@color/navy_blue"
            app:labelVisibilityMode="labeled"
            app:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:menu="@menu/bottom_menu_client"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface_background"
        app:headerLayout="@layout/nav_header_client"
        app:menu="@menu/drawer_menu_client"
        app:itemIconTint="@color/navy_blue"
        app:itemTextColor="@color/text_primary"
        />

</androidx.drawerlayout.widget.DrawerLayout>