<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".Client.clientHome">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_main">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:background="@color/card_bg"
            android:paddingHorizontal="@dimen/margin_medium"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/logo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="@dimen/corner2"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_appicon"
                    android:contentDescription="Logo" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:text="Top Software"
                android:textColor="@color/blue"
                android:textSize="@dimen/txt_medium"
                android:textStyle="bold"
                android:fontFamily="@font/playfair" />

            <ImageView
                android:id="@+id/iv_hamburger"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_hamburger"
                android:padding="8dp"
                android:contentDescription="Menu"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/blue"
                />

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
            app:layout_constraintTop_toBottomOf="@id/header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bienvenue,"
                    android:textColor="@color/text_main"
                    android:textSize="@dimen/txt_large"
                    android:alpha="0.7"
                    android:fontFamily="@font/cairo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mohammed Ahmed"
                    android:textColor="@color/blue"
                    android:textSize="@dimen/txt_large"
                    android:textStyle="bold"
                    android:fontFamily="@font/cairo" />

                <View
                    android:layout_width="60dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/blue" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_large"
                    app:cardBackgroundColor="@color/blue"
                    app:cardCornerRadius="@dimen/corner1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/margin_medium">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tableau de Bord"
                            android:textColor="@color/pure_white"
                            android:fontFamily="@font/cairo"
                            android:textSize="@dimen/txt_medium"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gestion de vos équipements et demandes d'assistance."
                            android:textColor="@color/pure_white"
                            android:alpha="0.9"
                            android:fontFamily="@font/cairo"
                            android:textSize="@dimen/txt_small" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mb_addTicket"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="@dimen/margin_medium"
                            android:text="Nouveau Ticket"
                            android:textAllCaps="false"
                            android:textColor="@color/blue"
                            app:backgroundTint="@color/pure_white"
                            android:textSize="@dimen/txt_medium"
                            android:fontFamily="@font/cairo"
                            app:cornerRadius="@dimen/corner1"
                            app:icon="@android:drawable/ic_input_add"
                            app:iconTint="@color/blue"
                            />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_large"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:text="DEMANDES DES SERVICES"
                    android:textColor="@color/text_main"
                    android:textSize="@dimen/txt_small"
                    android:fontFamily="@font/cairo"
                    android:textStyle="bold"
                    android:alpha="0.8" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@drawable/bg_border_radius_blue"
                    android:backgroundTint="@color/softGray">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewDemandes"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        tools:listitem="@layout/item_client_demande" />

                    <ProgressBar
                        android:id="@+id/pb_home_demandes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/blue"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/tvEmptyDemandes"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Aucune Demande !"
                        android:textColor="@color/hintGray"
                        android:textSize="@dimen/txt_small"
                        android:gravity="center"
                        android:visibility="gone"
                        android:fontFamily="@font/cairo" />

                </FrameLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    app:cardBackgroundColor="@color/blue"
                    app:cardCornerRadius="@dimen/corner1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/margin_medium">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Support Urgent 24/7"
                            android:textColor="@color/pure_white"
                            android:textSize="@dimen/txt_large"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_small"
                            android:text="Assistance immédiate pour les pannes critiques."
                            android:textColor="@color/pure_white"
                            android:alpha="0.8" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mb_callTechnician"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="16dp"
                            app:backgroundTint="@color/pure_white"
                            android:text="Appeler un technicien"
                            android:textAllCaps="false"
                            android:fontFamily="@font/cairo"
                            android:textColor="@color/pure_black"
                            android:textSize="@dimen/txt_medium"
                            app:cornerRadius="@dimen/corner1"
                            app:icon="@drawable/ic_phone"
                            app:iconTint="@color/pure_black"
                            />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/blue"
            app:itemTextColor="@color/blue"
            app:labelVisibilityMode="labeled"
            app:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:menu="@menu/menu_client_bottom"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/background_main"
        app:headerLayout="@layout/nav_header_client"
        app:menu="@menu/drawer_menu_client"
        app:itemIconTint="@color/blue"
        app:itemTextColor="@color/text_main"
        app:itemShapeFillColor="@color/softGray"
        />

</androidx.drawerlayout.widget.DrawerLayout>
