<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:fitsSystemWindows="true"
    tools:context=".views.MainActivity">

    <FrameLayout
        android:id="@+id/header_frame"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_services"
            android:scaleType="centerCrop"
            android:contentDescription="Service Background"
            />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_fade_gradient"
            />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/margin_medium"
        android:background="@color/background_main"
        app:layout_constraintTop_toBottomOf="@id/header_frame"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:src="@drawable/img_logo"
            android:contentDescription="App Logo"
            android:layout_marginTop="16dp"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/navy_blue"
            android:textSize="28sp"
            android:fontFamily="@font/playfair"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:text="@string/headline"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/txt_small"
            android:fontFamily="@font/cairo"
            android:text="@string/headline_description"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="24dp"
            />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            />

        <!-- Action Buttons Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="16dp">

            <!-- Primary Action: Connecter -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/mb_login"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="@string/connecter"
                android:textStyle="bold"
                android:fontFamily="@font/cairo"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/navy_blue"
                app:cornerRadius="16dp"
                app:elevation="4dp"
                />

            <!-- Secondary Action: Registre -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/mb_register"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/registre"
                android:fontFamily="@font/cairo"
                android:textSize="16sp"
                android:textColor="@color/navy_blue"
                app:strokeColor="@color/navy_blue"
                app:strokeWidth="1.5dp"
                app:cornerRadius="16dp"
                />

            <!-- Language Switcher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ln_arLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/arabe"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/txt_small"
                    android:fontFamily="@font/cairo"
                    android:padding="@dimen/margin_small"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    />

                <View
                    android:layout_width="1dp"
                    android:layout_height="@dimen/margin_medium"
                    android:background="@color/hintGray"
                    android:layout_marginHorizontal="@dimen/margin_small"
                    />

                <TextView
                    android:id="@+id/ln_frLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/francais"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/txt_small"
                    android:fontFamily="@font/cairo"
                    android:padding="@dimen/margin_small"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    />

            </LinearLayout>

            <!-- Admin Access -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/mb_espace_entreprise"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@string/espace_entreprise"
                android:textAllCaps="false"
                android:fontFamily="@font/cairo"
                android:textSize="@dimen/txt_small"
                android:textColor="@color/hintGray"
                app:rippleColor="@color/softGray"
                />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
