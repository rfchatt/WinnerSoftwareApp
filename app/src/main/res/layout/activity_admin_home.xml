<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".views.admin.adminHome">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_background">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center_vertical"
            android:background="@color/surface_card"
            android:paddingHorizontal="16dp"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/img_logo"
                android:scaleType="fitStart"
                />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/margin_medium"
                android:text="Admin Panel"
                android:textColor="@color/navy_blue"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/playfair"
                />

            <ImageView
                android:id="@+id/iv_hamburger"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/img_hamburger"
                android:padding="8dp"
                android:contentDescription="Menu"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/navy_blue"
                />

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
            app:layout_constraintTop_toBottomOf="@id/header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_small">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Les nouveau Tickets"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/txt_medium"
                    android:fontFamily="@font/cairo"
                    android:textStyle="bold"
                    />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:minHeight="150dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_admin_tickets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_new_user_validation"
                        tools:itemCount="3"
                        />

                    <ProgressBar
                        android:id="@+id/pb_ticket_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/navy_blue"
                        android:visibility="visible"
                        />

                    <TextView
                        android:id="@+id/tv_no_tickets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Aucune demande récente"
                        android:textColor="@color/hintGray"
                        android:textSize="@dimen/txt_small"
                        android:fontFamily="@font/cairo"
                        android:visibility="gone"
                        />

                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/navy_blue"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Statistiques Globales"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/txt_medium"
                    android:textStyle="bold"
                    android:fontFamily="@font/cairo"
                    />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:columnCount="2"
                    android:rowCount="1">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:minHeight="50dp"
                        android:layout_columnWeight="1"
                        app:cardCornerRadius="@dimen/corner1"
                        android:layout_marginEnd="2dp"
                        app:strokeColor="@color/navy_blue"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@android:color/transparent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:minHeight="50dp"
                            android:gravity="center_vertical"
                            android:padding="@dimen/margin_small"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_tickets_open_count"
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="--"
                                android:textStyle="bold"
                                android:paddingHorizontal="5dp"
                                android:fontFamily="@font/cairo"
                                android:textColor="@color/navy_blue"
                                android:textSize="@dimen/txt_small"
                                />

                            <View
                                android:layout_width="2dp"
                                android:layout_height="2dp"
                                android:background="@color/navy_blue"
                                />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Tickets Ouverts"
                                android:textStyle="bold"
                                android:textColor="@color/navy_blue"
                                android:textSize="@dimen/txt_small"
                                android:fontFamily="@font/cairo"
                                />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:minHeight="50dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="2dp"
                        app:cardCornerRadius="@dimen/corner1"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/primary_blue"
                        app:cardBackgroundColor="@android:color/transparent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="50dp"
                            android:gravity="center"
                            android:padding="@dimen/margin_small"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_clients_tt"
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:paddingHorizontal="5dp"
                                android:text="--"
                                android:textColor="@color/primary_blue"
                                android:fontFamily="@font/cairo"
                                android:textSize="@dimen/txt_small"
                                />

                            <View
                                android:layout_width="2dp"
                                android:layout_height="2dp"
                                android:background="@color/primary_blue"
                                />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:text="Clients Approuvés"
                                android:textColor="@color/primary_blue"
                                android:fontFamily="@font/cairo"
                                android:textSize="@dimen/txt_small"
                                />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </GridLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/navy_blue"
                    android:layout_marginTop="@dimen/margin_medium"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:text="Vérification des nouveaux clients"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/txt_medium"
                    android:fontFamily="@font/cairo"
                    android:textStyle="bold"
                    />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:minHeight="150dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_admin_demandes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:listitem="@layout/item_admin_demande"
                        tools:itemCount="3"
                        />

                    <ProgressBar
                        android:id="@+id/pb_admin_loading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/navy_blue"
                        android:visibility="visible"
                        />

                    <TextView
                        android:id="@+id/tv_admin_empty_demandes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Aucune demande récente"
                        android:textColor="@color/hintGray"
                        android:textSize="@dimen/txt_small"
                        android:fontFamily="@font/cairo"
                        android:visibility="gone"
                        />

                </FrameLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_card"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/navy_blue"
            app:itemTextColor="@color/navy_blue"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:menu="@menu/bottom_menu_admin"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface_background"
        app:headerLayout="@layout/nav_header_admin"
        app:menu="@menu/drawer_menu_admin"
        app:itemIconTint="@color/navy_blue"
        app:itemTextColor="@color/text_primary"
        />

</androidx.drawerlayout.widget.DrawerLayout>